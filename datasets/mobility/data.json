  "rules": {
    "R-EV": {"name": "EV return rule", "min_return_percent": 20, "charge_buffer_percent": 5, "description": "Electric cars must be returned with at least 20% charge, otherwise a low-charge fee applies."},
    "R-BOOKING": {"name": "Booking rule", "turnaround_minutes": 15, "start_lead_minutes": 5, "walking_metres_per_minute": 80, "description": "15 minutes between two bookings of the same car; a new booking starts at the earliest 5 minutes from now."},
    "R-DISCOUNT": {"name": "Discount rule", "allowed": false, "description": "The assistant never grants discounts or waives fees; it may point to the plans."},
    "R-LATE": {"name": "Late return", "topic": "late return", "grace_minutes": 10, "fee_per_15_minutes": 15, "description": "If you bring a car back more than 10 minutes late, a late fee of CHF 15 is charged for every started 15 minutes. If the next customer cannot start on time because of the delay, their replacement costs can be charged to you as well. As long as nobody has booked the car after you, you can extend the booking in the app or by phone at any time, also while you are driving."},
    "R-ABROAD": {"name": "Trips abroad", "topic": "driving abroad", "allowed_countries": ["Germany", "Austria", "France", "Italy", "Liechtenstein"], "description": "Our cars may be driven to Germany, Austria, France, Italy and Liechtenstein. Tick 'trip abroad' when you book, or tell us by phone; it costs nothing extra and the insurance and breakdown assistance abroad are included. Tolls and vignettes abroad are paid by the driver. Electric cars can be charged abroad with the charging card in the car. Trips to any other country are not allowed. A booking abroad can be made up to 6 months in advance, like any booking."},
    "R-DAMAGE": {"name": "Damage", "topic": "damage", "check_working_days": 2, "description": "Report any damage before you drive off, by phone or in the app. We then text you a link to add photos: one photo of each damage, and one of the whole side of the car where it is. Damage reported before the trip is never charged to you. Do not drive if the damage affects safety (lights, mirrors, tyres, windscreen, brakes); we then move your booking to another car at no extra cost. When you bring the car back, park and lock it as normal; nothing else is needed. The damage team checks a reported car within 2 working days."},
    "R-CLEAN": {"name": "Cleaning", "topic": "cleaning fee", "fee": 80, "review_working_days": 3, "refund_working_days": 5, "description": "Normal use is fine: some sand, dust, light dirt or crumbs are never charged. A cleaning fee of CHF 80 is charged when a car needs extra cleaning: pet hair, smoke, food waste, heavy mud or spilled liquids. The fee is based on the report and photos of the next customer or the cleaning team. A disputed fee is put on hold and reviewed by the billing team within 3 working days; if they agree with the customer, the fee is refunded to the card on file within 5 working days."},
    "R-DRIVERS": {"name": "Drivers", "topic": "other drivers", "description": "Only registered members may drive our cars. A co-driver registers in the app (about 5 minutes, with a photo of the driving licence) and is then added to the booking in the app, at no extra cost. Co-drivers cannot be added by phone. The person who booked stays responsible for the car."},
    "R-PETS": {"name": "Pets", "topic": "pets", "description": "Pets may travel in our cars in a closed transport box or on a seat cover in the boot. Pet hair left in the car leads to a cleaning fee of CHF 80."},
    "R-EXTRAS": {"name": "Van extras", "topic": "extras", "extras": {"trolley": {"name": "sack trolley", "price": 5}, "blankets": {"name": "moving blankets", "price": 5}}, "description": "For vans, a sack trolley and moving blankets can be added to a booking for CHF 5 each. They are in the van when you pick it up."}
  }
