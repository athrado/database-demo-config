  "rules": {
    "R-DOCLINKS": {
      "name": "Document links in chat",
      "description": "When a customer asks for documents (e.g. transfer receipts), list the links in the chat as long as there are no more than max_links_in_chat of them. Above that, send the link to the documents page instead.",
      "max_links_in_chat": 5,
      "documents_page_field": "documents_page_url",
      "action": "Send the links, or the link in the customer's documents_page_url when there are too many",
      "status": "active"
    },
    "R-LOWBAL": {
      "name": "Low average balance",
      "description": "Average balance of the current account below the threshold over the period: the assistant contacts the customer proactively and offers help with liquidity.",
      "threshold": 300,
      "currency": "EUR",
      "period_months": 3,
      "action": "Proactive contact, then offer a personal loan",
      "requires": "loan_eligible = true in the customer's credit profile",
      "status": "active"
    },
    "R-IDENTITY": {
      "name": "Security interview (password reset)",
      "description": "Before a password is reset the assistant asks three questions and sends the answers to the bank service, which says whether they are correct. The stored values are masked (* = a hidden character, the full numbers are never kept), so the answer is compared with the visible characters only, ignoring case and spaces.",
      "questions": [
        {
          "id": "id_card",
          "ask": "Please tell me your ID card number.",
          "expected_from": "customers.identity.id_card_masked",
          "compare": "visible characters"
        },
        {
          "id": "account_last3",
          "ask": "What are the last three digits of your current account?",
          "expected_from": "the last 3 digits of the IBAN of the caller's current account (accounts.iban)",
          "compare": "exact"
        },
        {
          "id": "tax_code",
          "ask": "And your tax code, please.",
          "expected_from": "customers.identity.tax_code_masked",
          "compare": "visible characters"
        }
      ],
      "pass_when": "all three answers are correct",
      "max_attempts_per_day": 3,
      "attempts_logged_in": "identity_checks",
      "when_locked": "Do not try again: hand over to an operator",
      "result_fields": {
        "valid": "true when all three are correct",
        "failed_fields": "the questions that did not match"
      },
      "status": "active"
    },
    "R-PWRESET": {
      "name": "Password reset by phone",
      "description": "The caller is recognised by the phone number (customers.phone). If customers.online_banking.password_status is blocked the assistant says so and offers a reset. After a successful security interview (R-IDENTITY) there are two ways to finish.",
      "precondition": "online_banking.password_status = blocked",
      "case_3a": {
        "name": "Hand over to an operator",
        "queue": "Online banking support",
        "note_for_operator": "Security interview passed on the call (<started>); caller <name> (<customer_id>). The online banking password is blocked since <blocked_since>. Please reset it.",
        "tell_the_customer": "A colleague will take the call and complete the reset."
      },
      "case_3b": {
        "name": "Reset through the backend banking service",
        "request": {
          "customer_id": "the customer",
          "identity_verified": true,
          "channel": "Phone",
          "delivery": "SMS to the phone number on file"
        },
        "result": "OK or KO, with reason_code and detail",
        "formulate_from": "detail (OK) or ko_reasons[reason_code] (KO): never read internal codes out loud",
        "logged_in": "password_requests"
      },
      "rate_limit": "one reset per customer per 24 hours; a second request is refused with ALREADY_REQUESTED",
      "ko_reasons": {
        "ALREADY_REQUESTED": "A temporary password was already sent today. Please check your SMS; if it does not arrive, a colleague can help.",
        "KYC_PENDING": "Your identity check is not complete yet, so I cannot reset it automatically. I will transfer you to a colleague.",
        "INTERVIEW_FAILED": "I could not confirm your identity. For your security I will transfer you to a colleague."
      },
      "status": "active"
    }
  },
