# Copy this file to .env and fill it in. .env is private and never goes to git; this template can be shared.

# Azure Table Storage (leave empty to try the app with local files)
EXT_DATA_ACCOUNT_URL=https://<storageaccount>.table.core.windows.net
EXT_DATA_SAS_TOKEN=?sv=<paste the table SAS token here>
EXT_DATA_TABLE=demoretail          # only for a config that names no table

# Documents (banking receipts): a SEPARATE, read-only token for the documents container only
EXT_DATA_DOCS_URL=https://<storageaccount>.blob.core.windows.net/documents
EXT_DATA_DOCS_SAS=?sv=<read-only container token>

# GitHub: lets "Update seed data" commit to the repository (leave empty to only write the local file)
GITHUB_TOKEN=<fine-grained token: this repository only, Contents = Read and write>
GITHUB_REPO=<owner>/<repository>
GITHUB_BRANCH=main
